{
    "name": "sozodesign/paris",
    "type": "library",
    "description": "SOZO fork of Paris for PHP 8.4+: a lightweight Active Record implementation built on top of Idiorm",
    "keywords": [
        "paris",
        "orm",
        "active record",
        "model"
    ],
    "homepage": "https://github.com/sozo-design/paris",
    "support": {
        "issues": "https://github.com/sozo-design/paris/issues",
        "source": "https://github.com/sozo-design/paris"
    },
    "authors": [
        {
            "name": "Jamie Matthews",
            "email": "jamie.matthews@gmail.com",
            "homepage": "http://j4mie.org",
            "role": "Developer"
        },
        {
            "name": "Simon Holywell",
            "email": "treffynnon@php.net",
            "homepage": "http://simonholywell.com",
            "role": "Maintainer"
        },
        {
            "name": "Durham Hale",
            "email": "me@durhamhale.com",
            "homepage": "http://durhamhale.com",
            "role": "Maintainer"
        },
        {
            "name": "Clive Walkden",
            "homepage": "https://sozodesign.co.uk",
            "role": "Maintainer of the SOZO fork"
        }
    ],
    "license": [
        "BSD-2-Clause",
        "BSD-3-Clause",
        "BSD-4-Clause"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/sozo-design/idiorm"
        }
    ],
    "require": {
        "php": ">=8.4",
        "sozodesign/idiorm": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "ext-pdo_sqlite": "*"
    },
    "replace": {
        "j4mie/paris": "self.version"
    },
    "conflict": {
        "clivewalkden/paris": "*"
    },
    "autoload": {
        "classmap": [
            "paris.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    }
}
